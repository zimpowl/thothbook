# Copie ce fichier en .env et renseigne tes valeurs. Le .env n'est JAMAIS commité.

# --- Neo4j ---
NEO4J_PASSWORD=

# --- LLM (selon le provider choisi dans config.yaml) ---
# Gemini (provider: google_genai)
GOOGLE_API_KEY=
# OpenAI (provider: openai)
OPENAI_API_KEY=

# --- Firebase (auth) ---
# Dev local UNIQUEMENT : chemin vers le JSON de compte de service Firebase
# (Console Firebase -> Paramètres du projet -> Comptes de service -> Générer une clé privée).
# Sur Cloud Run, NE PAS définir : les Application Default Credentials sont automatiques.
FIREBASE_CREDENTIALS=

# --- Stripe (paiements crédits) ---
# URL publique de l'app (ex: https://thothbook.web.app) pour les retours Checkout.
APP_BASE_URL=
# Clé secrète du compte Stripe (test ou live selon l'environnement).
STRIPE_SECRET_KEY=
# Secret de signature du webhook Stripe -> endpoint /api/paiements/webhook
STRIPE_WEBHOOK_SECRET=

